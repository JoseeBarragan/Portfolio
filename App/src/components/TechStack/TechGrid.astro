---
const technologies = [
  { name: 'TypeScript', icon: 'typescript' },
  { name: 'Prisma', icon: 'prisma' },
  { name: 'PostgreSQL', icon: 'postgresql' },
  { name: 'JavaScript', icon: 'javascript' },
  { name: 'Node.js', icon: 'nodejs' },
  { name: 'React', icon: 'react' },
  { name: 'Express', icon: 'express' },
  { name: 'Docker', icon: 'docker' },
  { name: 'Astro', icon: 'astro' },
  { name: 'Nest', icon: 'nestjs' },
  { name: 'HTML', icon: 'html5' },
  { name: 'CSS', icon: 'css3' },
  { name: 'Tailwind', icon: 'tailwindcss' },
  { name: 'MySQL', icon: 'mysql' },
  { name: 'Redis', icon: 'redis' },
  { name: 'Git', icon: 'git' },
  { name: 'GitHub', icon: 'github' },
  { name: 'Linux', icon: 'linux' },
  { name: 'VS Code', icon: 'vscode' },
  { name: 'Vite', icon: 'vitejs' },
  { name: 'Neovim', icon: 'neovim' },
  { name: 'Railway', icon: 'railway' },
  { name: 'Postman', icon: 'postman' },
  { name: 'Vercel', icon: 'vercel' },
];
---

<div id="techstack-label-wrapper" class="relative flex z-900 justify-center mb-16">
  <!-- Base layer -->
  <h2 class="text-4xl font-bold text-white select-none">TECH & SKILLS</h2>

  <!-- Mask layer -->
  <div
    id="techstack-mask-layer"
    class="absolute inset-0 flex delayed-position justify-center pointer-events-none"
    style="-webkit-mask-image: radial-gradient(circle 25px at var(--x, -999px) var(--y, -999px), black 90%, transparent 10%); mask-image: radial-gradient(circle 25px at var(--x, -999px) var(--y, -999px), black 90%, transparent 10%);"
  >
    <h2 class="text-4xl font-bold text-black">TECH & SKILLS</h2>
  </div>
</div>
<div class="grid grid-cols-4 sm:grid-cols-5 z-1000 gap-2 sm:gap-4 max-w-xl sm:max-w-4xl mx-auto lg:flex lg:flex-wrap lg:justify-center">
  {technologies.map((tech) => (
    <div class="w-full aspect-square lg:w-24 lg:h-24 flex flex-col z-900 items-center justify-center rounded-xl lg:rounded-2xl bg-white/5 backdrop-blur-xl border border-white/10 hover:border-[#b697ee] shadow-[0_4px_12px_rgba(0,0,0,0.2)] transition-all duration-150 ease-in-out hover:bg-white/10 hover:scale-110">
      <img
        src={`https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${tech.icon}/${tech.icon}-original.svg`}
        alt={tech.name}
        class="w-6 h-6 sm:w-8 sm:h-8 lg:w-10 lg:h-10 mb-1 sm:mb-2"
      />
      <span class="text-[8px] sm:text-[10px] font-medium text-white/70 leading-none text-center px-1 truncate w-full">{tech.name}</span>
    </div>
  ))}
</div>
